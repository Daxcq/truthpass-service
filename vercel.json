{
  "version": 2,
  "functions": {
    "api/[[...path]].ts": {
      "runtime": "nodejs22.x",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[[...path]].ts" },
    { "source": "/assets/:path*", "destination": "/web-frontend/dist/assets/:path*" },
    { "source": "/frontend/:path*", "destination": "/web-frontend/dist/:path*" },
    { "source": "/", "destination": "/web-frontend/dist/index.html" },
    { "source": "/:path*", "destination": "/web-frontend/dist/index.html" }
  ]
}
